{
  "name": "auditing-skills",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/run-all.mjs",
    "validate:schema": "node shared/validators/validate.mjs",
    "merge:ledger": "node shared/ledger/merge.mjs",
    "test:artifact-location": "node tests/artifact-location.mjs",
    "test:manifests": "node tests/manifests.mjs",
    "test:aud": "node plugins/aud/tests/acceptance.mjs",
    "test:synthesis": "node tests/synthesis.mjs",
    "test:verification": "node tests/verification.mjs",
    "test:calibration": "node tests/calibration.mjs",
    "calibrate": "node shared/calibration/cli.mjs --suite calibration/corpus/suite.json --tier full --baseline calibration/baselines/accepted.json",
    "calibrate:fast": "node shared/calibration/cli.mjs --suite calibration/corpus/suite.json --tier fast --baseline calibration/baselines/accepted.json --check",
    "calibrate:full": "node shared/calibration/cli.mjs --suite calibration/corpus/suite.json --tier full --baseline calibration/baselines/accepted.json --check",
    "test:audit": "node plugins/audit/tests/acceptance.mjs",
    "test:functional-audit": "node plugins/functional-audit/tests/acceptance.mjs",
    "test:content-audit": "node plugins/content-audit/tests/acceptance.mjs",
    "test:place-audit": "node plugins/place-audit/tests/acceptance.mjs",
    "test:flow-audit": "node plugins/flow-audit/tests/acceptance.mjs",
    "test:visual-audit": "node plugins/visual-audit/tests/acceptance.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright": "1.62.1"
  }
}
