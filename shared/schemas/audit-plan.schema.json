{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aud:schema:audit-plan:v1",
  "title": "AUD audit plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "run_id", "mode", "generated_at", "project_revision", "requested_scope", "context_status", "prior_open_finding_refs", "decisions", "execution_waves", "evidence_baseline", "degraded", "degraded_consequences", "report_only", "application_mutation_allowed", "deferred_capabilities"],
  "properties": {
    "schema_version": { "const": "aud-audit-plan-v1" },
    "plan_id": { "type": "string", "pattern": "^AP-[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
    "run_id": { "$ref": "urn:aud:schema:common:v1#/$defs/runId" },
    "mode": { "enum": ["diagnose", "redesign", "verify", "specialist"] },
    "generated_at": { "$ref": "urn:aud:schema:common:v1#/$defs/timestamp" },
    "project_revision": { "$ref": "urn:aud:schema:common:v1#/$defs/sha" },
    "requested_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspects", "routes", "states", "persona_refs", "requested_specialist"],
      "properties": {
        "aspects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "routes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "states": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "persona_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "requested_specialist": { "type": ["string", "null"] }
      }
    },
    "context_status": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "state", "reason"],
        "properties": {
          "kind": { "enum": ["project-context", "task-model", "prior-ledger", "content-contract", "capture-manifest"] },
          "state": { "enum": ["current", "missing", "stale", "incompatible", "not-applicable"] },
          "reason": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
          "artifact_ref": { "type": "string" }
        }
      }
    },
    "prior_open_finding_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/findingId" }, "uniqueItems": true },
    "decisions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audit", "disposition", "reason", "dependencies", "degraded", "consequences"],
        "properties": {
          "audit": { "enum": ["content-audit", "place-audit", "flow-audit", "visual-audit", "functional-audit"] },
          "disposition": { "enum": ["selected", "skipped", "deferred"] },
          "reason": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
          "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "degraded": { "type": "boolean" },
          "consequences": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "execution_waves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wave", "audits", "readiness_condition"],
        "properties": {
          "wave": { "type": "integer", "minimum": 1 },
          "audits": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "readiness_condition": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" }
        }
      }
    },
    "evidence_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_manifest_ref", "project_revision", "baseline_signature", "state"],
      "properties": {
        "capture_manifest_ref": { "type": "string" },
        "project_revision": { "$ref": "urn:aud:schema:common:v1#/$defs/sha" },
        "baseline_signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "state": { "enum": ["planned", "current", "reused", "degraded"] }
      }
    },
    "degraded": { "type": "boolean" },
    "degraded_consequences": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "report_only": { "type": "boolean" },
    "application_mutation_allowed": { "const": false },
    "deferred_capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "allOf": [{
    "if": { "properties": { "mode": { "const": "diagnose" } }, "required": ["mode"] },
    "then": { "properties": { "report_only": { "const": true }, "application_mutation_allowed": { "const": false } } }
  }]
}
