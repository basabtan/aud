{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aud:schema:content-contract:v1",
  "title": "AUD content contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "run_id", "project_revision", "generated_at", "content_items", "view_contracts", "human_owned_decisions", "assumptions", "status"],
  "properties": {
    "schema_version": { "const": "aud-content-contract-v1" },
    "contract_id": { "type": "string", "pattern": "^CC-[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
    "run_id": { "$ref": "urn:aud:schema:common:v1#/$defs/runId" },
    "project_revision": { "$ref": "urn:aud:schema:common:v1#/$defs/sha" },
    "generated_at": { "$ref": "urn:aud:schema:common:v1#/$defs/timestamp" },
    "content_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "responsibility", "provenance_refs", "role_refs", "journey_stage_refs", "decision", "merged_into"],
        "properties": {
          "id": { "$ref": "urn:aud:schema:common:v1#/$defs/contentId" },
          "statement": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
          "responsibility": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
          "provenance_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/evidenceId" }, "uniqueItems": true },
          "role_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "journey_stage_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "decision": { "enum": ["keep", "merge", "disclose", "remove", "human_decision"] },
          "merged_into": { "oneOf": [{ "$ref": "urn:aud:schema:common:v1#/$defs/contentId" }, { "type": "null" }] }
        },
        "allOf": [
          {
            "if": { "type": "object", "properties": { "decision": { "const": "merge" } }, "required": ["decision"] },
            "then": { "type": "object", "properties": { "merged_into": { "$ref": "urn:aud:schema:common:v1#/$defs/contentId" } } },
            "else": { "type": "object", "properties": { "merged_into": { "type": "null" } } }
          }
        ]
      }
    },
    "view_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "content_refs", "minimum_first_read", "progressive_disclosure"],
        "properties": {
          "id": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
          "purpose": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
          "content_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/contentId" }, "uniqueItems": true },
          "minimum_first_read": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/contentId" }, "uniqueItems": true },
          "progressive_disclosure": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/contentId" }, "uniqueItems": true }
        }
      }
    },
    "human_owned_decisions": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" } },
    "assumptions": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" } },
    "status": { "enum": ["draft", "accepted", "superseded"] }
  }
}
