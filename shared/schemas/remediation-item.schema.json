{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aud:schema:remediation-item:v1",
  "title": "AUD remediation item v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "remediation_id", "title", "problem_statement", "finding_refs", "cluster_refs", "affected_areas", "action_type", "recommended_action", "expected_outcome", "acceptance_criteria", "verification_method", "priority", "dependencies", "blockers", "implementation_risk", "estimated_effort", "confidence", "owner_capability", "status", "parallel_ready", "wave"],
  "properties": {
    "schema_version": { "const": "aud-remediation-item-v1" },
    "remediation_id": { "$ref": "urn:aud:schema:common:v1#/$defs/remediationId" },
    "title": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
    "problem_statement": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
    "finding_refs": { "type": "array", "minItems": 1, "items": { "$ref": "urn:aud:schema:common:v1#/$defs/findingId" }, "uniqueItems": true },
    "cluster_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/clusterId" }, "uniqueItems": true },
    "affected_areas": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "action_type": { "enum": ["investigate", "decide", "implement", "verify", "defer", "accept_risk"] },
    "recommended_action": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
    "expected_outcome": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "$ref": "urn:aud:schema:common:v1#/$defs/acceptanceCriterion" } },
    "verification_method": { "type": "array", "minItems": 1, "items": { "$ref": "urn:aud:schema:common:v1#/$defs/verificationMethod" } },
    "priority": {
      "type": "object", "additionalProperties": false, "required": ["level", "band", "rationale", "factors"],
      "properties": {
        "level": { "enum": ["critical", "high", "medium", "low", "deferred"] },
        "band": { "enum": ["P0", "P1", "P2", "P3", "P4"] },
        "rationale": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
        "factors": {
          "type": "object", "additionalProperties": false,
          "required": ["consequence_severity", "affected_scope", "task_criticality", "urgency", "confidence", "recurrence", "blocking_relationships", "remediation_dependencies", "implementation_risk", "estimated_effort"],
          "properties": {
            "consequence_severity": { "type": "integer", "minimum": 0, "maximum": 4 },
            "affected_scope": { "enum": ["element", "component", "surface", "route", "journey", "system"] },
            "task_criticality": { "type": "number", "minimum": 0, "maximum": 1 },
            "urgency": { "enum": ["low", "medium", "high", "immediate"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "recurrence": { "enum": ["rare", "occasional", "common", "continuous", "unknown"] },
            "blocking_relationships": { "type": "integer", "minimum": 0 },
            "remediation_dependencies": { "type": "integer", "minimum": 0 },
            "implementation_risk": { "enum": ["low", "medium", "high", "unknown"] },
            "estimated_effort": { "enum": ["XS", "S", "M", "L", "XL", "unknown"] }
          }
        }
      }
    },
    "dependencies": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/remediationId" }, "uniqueItems": true },
    "blockers": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/remediationId" }, "uniqueItems": true },
    "implementation_risk": {
      "type": "object", "additionalProperties": false, "required": ["level", "rationale"],
      "properties": {
        "level": { "enum": ["low", "medium", "high", "unknown"] },
        "rationale": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" }
      }
    },
    "estimated_effort": { "enum": ["XS", "S", "M", "L", "XL", "unknown"] },
    "confidence": { "$ref": "urn:aud:schema:common:v1#/$defs/confidence" },
    "owner_capability": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
    "status": { "enum": ["proposed", "needs_decision", "accepted", "deferred", "risk_accepted"] },
    "parallel_ready": { "type": "boolean" },
    "wave": { "type": ["integer", "null"], "minimum": 1 }
  }
}
