{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:aud:schema:calibration-suite:v1", "title": "AUD calibration suite v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "suite_id", "suite_version", "name", "created_at", "description", "cases", "quality_gates", "corpus_policy"],
  "properties": {
    "schema_version": { "const": "aud-calibration-suite-v1" }, "suite_id": { "type": "string", "pattern": "^CALSUITE-" }, "suite_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }, "name": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" }, "created_at": { "$ref": "urn:aud:schema:common:v1#/$defs/timestamp" }, "description": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "urn:aud:schema:calibration-case:v1" } },
    "quality_gates": { "type": "object", "additionalProperties": false, "required": ["policy_version", "hard", "warning", "informational"], "properties": { "policy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }, "hard": { "$ref": "#/$defs/gates" }, "warning": { "$ref": "#/$defs/gates" }, "informational": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } },
    "corpus_policy": { "type": "object", "additionalProperties": false, "required": ["redistributable", "contains_sensitive_evidence", "application_mutations"], "properties": { "redistributable": { "const": true }, "contains_sensitive_evidence": { "const": false }, "application_mutations": { "type": "array", "maxItems": 0 } } }
  },
  "$defs": { "gates": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["metric", "operator", "value", "rationale"], "properties": { "metric": { "type": "string" }, "operator": { "enum": [">=", "<=", "=="] }, "value": { "type": "number" }, "rationale": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" } } } } }
}
