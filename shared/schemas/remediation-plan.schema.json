{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aud:schema:remediation-plan:v2",
  "title": "AUD remediation plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "run_id", "synthesis_id", "generated_at", "project_revision", "items", "waves", "cycle_detection", "human_decisions", "authority"],
  "properties": {
    "schema_version": { "const": "aud-remediation-plan-v2" },
    "plan_id": { "type": "string", "pattern": "^RP-[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
    "run_id": { "$ref": "urn:aud:schema:common:v1#/$defs/runId" },
    "synthesis_id": { "type": "string", "pattern": "^SYN-[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
    "generated_at": { "$ref": "urn:aud:schema:common:v1#/$defs/timestamp" },
    "project_revision": { "$ref": "urn:aud:schema:common:v1#/$defs/sha" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "urn:aud:schema:remediation-item:v1" } },
    "waves": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["wave", "remediation_refs", "parallel_ready"],
        "properties": {
          "wave": { "type": "integer", "minimum": 1 },
          "remediation_refs": { "type": "array", "minItems": 1, "items": { "$ref": "urn:aud:schema:common:v1#/$defs/remediationId" }, "uniqueItems": true },
          "parallel_ready": { "type": "boolean" }
        }
      }
    },
    "cycle_detection": {
      "type": "object", "additionalProperties": false, "required": ["detected", "cycles"],
      "properties": {
        "detected": { "type": "boolean" },
        "cycles": { "type": "array", "items": { "type": "array", "minItems": 2, "items": { "$ref": "urn:aud:schema:common:v1#/$defs/remediationId" }, "uniqueItems": true } }
      }
    },
    "human_decisions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["decision_id", "question", "finding_refs", "blocking_remediation_refs"],
        "properties": {
          "decision_id": { "type": "string", "pattern": "^DECISION-" },
          "question": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
          "finding_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/findingId" }, "uniqueItems": true },
          "blocking_remediation_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/remediationId" }, "uniqueItems": true }
        }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false, "required": ["analysis_only", "application_mutations", "verification_deferred"],
      "properties": {
        "analysis_only": { "const": true },
        "application_mutations": { "type": "array", "maxItems": 0 },
        "verification_deferred": { "const": true }
      }
    }
  }
}
