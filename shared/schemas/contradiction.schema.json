{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aud:schema:contradiction:v1",
  "title": "AUD contradiction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contradiction_id", "run_id", "project_revision", "finding_refs", "claims", "evidence_refs", "conflict_type", "resolution", "additional_evidence_required", "confidence"],
  "properties": {
    "schema_version": { "const": "aud-contradiction-v1" },
    "contradiction_id": { "$ref": "urn:aud:schema:common:v1#/$defs/contradictionId" },
    "run_id": { "$ref": "urn:aud:schema:common:v1#/$defs/runId" },
    "project_revision": { "$ref": "urn:aud:schema:common:v1#/$defs/sha" },
    "finding_refs": { "type": "array", "minItems": 2, "items": { "$ref": "urn:aud:schema:common:v1#/$defs/findingId" }, "uniqueItems": true },
    "claims": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["finding_id", "claim"],
        "properties": {
          "finding_id": { "$ref": "urn:aud:schema:common:v1#/$defs/findingId" },
          "claim": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" }
        }
      }
    },
    "evidence_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/evidenceId" }, "uniqueItems": true },
    "conflict_type": { "enum": ["factual", "contextual", "evaluative", "remedial"] },
    "resolution": {
      "type": "object", "additionalProperties": false, "required": ["status", "rationale", "selected_finding_id"],
      "properties": {
        "status": { "enum": ["unresolved", "resolved", "human_decision_required"] },
        "rationale": { "type": ["string", "null"] },
        "selected_finding_id": { "oneOf": [{ "$ref": "urn:aud:schema:common:v1#/$defs/findingId" }, { "type": "null" }] }
      }
    },
    "additional_evidence_required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "confidence": { "$ref": "urn:aud:schema:common:v1#/$defs/confidence" }
  }
}
