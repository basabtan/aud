{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aud:schema:finding:v1",
  "title": "AUD specialist finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "run_id", "source_audit", "category", "type", "title", "statement", "locations", "task_refs", "affected_personas", "affected_areas", "evidence_refs", "severity", "confidence", "reach", "frequency", "urgency", "native_metrics", "root_cause_hypothesis", "recommendation", "acceptance_criteria", "verification_method", "relationships", "status"],
  "properties": {
    "schema_version": { "const": "aud-finding-v1" },
    "id": { "$ref": "urn:aud:schema:common:v1#/$defs/findingId" },
    "run_id": { "$ref": "urn:aud:schema:common:v1#/$defs/runId" },
    "source_audit": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "category": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "type": { "enum": ["symptom", "risk", "cause_hypothesis", "constraint", "keep"] },
    "title": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
    "statement": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
    "locations": { "type": "array", "minItems": 1, "items": { "$ref": "urn:aud:schema:common:v1#/$defs/location" } },
    "task_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/taskId" }, "uniqueItems": true },
    "affected_personas": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "affected_areas": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "urn:aud:schema:common:v1#/$defs/evidenceId" }, "uniqueItems": true },
    "severity": { "$ref": "urn:aud:schema:common:v1#/$defs/severity" },
    "confidence": { "$ref": "urn:aud:schema:common:v1#/$defs/confidence" },
    "reach": { "enum": ["element", "component", "surface", "route", "journey", "system"] },
    "frequency": { "enum": ["rare", "occasional", "common", "continuous", "unknown"] },
    "urgency": { "enum": ["low", "medium", "high", "immediate"] },
    "native_metrics": { "$ref": "urn:aud:schema:common:v1#/$defs/nativeMetrics" },
    "root_cause_hypothesis": { "type": ["string", "null"] },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "alternatives", "estimated_effort", "change_risk"],
      "properties": {
        "action": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
        "alternatives": { "type": "array", "items": { "type": "string" } },
        "estimated_effort": { "enum": ["XS", "S", "M", "L", "XL", "unknown"] },
        "change_risk": { "enum": ["low", "medium", "high", "unknown"] }
      }
    },
    "acceptance_criteria": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/acceptanceCriterion" } },
    "verification_method": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/verificationMethod" } },
    "verification_absence_reason": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duplicates", "reinforces", "contradicts", "depends_on", "blocks", "caused_by"],
      "properties": {
        "duplicates": { "$ref": "#/$defs/findingRefs" },
        "reinforces": { "$ref": "#/$defs/findingRefs" },
        "contradicts": { "$ref": "#/$defs/findingRefs" },
        "depends_on": { "$ref": "#/$defs/findingRefs" },
        "blocks": { "$ref": "#/$defs/findingRefs" },
        "caused_by": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/causeId" }, "uniqueItems": true }
      }
    },
    "status": { "$ref": "urn:aud:schema:common:v1#/$defs/status" },
    "status_history": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/statusHistoryEntry" } },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_refs", "relationship_refs", "remediation_refs", "history"],
      "properties": {
        "cluster_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/clusterId" }, "uniqueItems": true },
        "relationship_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/relationshipId" }, "uniqueItems": true },
        "remediation_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/remediationId" }, "uniqueItems": true },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["synthesis_id", "run_id", "at"],
            "properties": {
              "synthesis_id": { "type": "string", "pattern": "^SYN-[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
              "run_id": { "$ref": "urn:aud:schema:common:v1#/$defs/runId" },
              "at": { "$ref": "urn:aud:schema:common:v1#/$defs/timestamp" }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "type": "object", "properties": { "acceptance_criteria": { "type": "array", "maxItems": 0 } }, "required": ["acceptance_criteria"] },
          { "type": "object", "properties": { "verification_method": { "type": "array", "maxItems": 0 } }, "required": ["verification_method"] }
        ]
      },
      "then": {
        "type": "object",
        "required": ["verification_absence_reason"],
        "properties": { "verification_absence_reason": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" } }
      }
    }
  ],
  "$defs": {
    "findingRefs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/findingId" }, "uniqueItems": true }
  }
}
