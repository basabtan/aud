{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aud:schema:issue-cluster:v1",
  "title": "AUD issue cluster v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cluster_id", "run_id", "representative_finding_id", "finding_refs", "duplicate_finding_refs", "grouping", "observed_symptoms", "inferred_root_cause", "supporting_evidence_refs", "conflicting_evidence_refs", "affected", "specialist_coverage", "root_cause_confidence", "unresolved_assumptions"],
  "properties": {
    "schema_version": { "const": "aud-issue-cluster-v1" },
    "cluster_id": { "$ref": "urn:aud:schema:common:v1#/$defs/clusterId" },
    "run_id": { "$ref": "urn:aud:schema:common:v1#/$defs/runId" },
    "representative_finding_id": { "$ref": "urn:aud:schema:common:v1#/$defs/findingId" },
    "finding_refs": { "type": "array", "minItems": 1, "items": { "$ref": "urn:aud:schema:common:v1#/$defs/findingId" }, "uniqueItems": true },
    "duplicate_finding_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/findingId" }, "uniqueItems": true },
    "grouping": {
      "type": "object", "additionalProperties": false, "required": ["rationale", "signals"],
      "properties": {
        "rationale": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
        "signals": { "type": "array", "minItems": 1, "items": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" }, "uniqueItems": true }
      }
    },
    "observed_symptoms": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["finding_id", "claim", "evidence_refs"],
        "properties": {
          "finding_id": { "$ref": "urn:aud:schema:common:v1#/$defs/findingId" },
          "claim": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
          "evidence_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/evidenceId" }, "uniqueItems": true }
        }
      }
    },
    "inferred_root_cause": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["statement", "inference", "provisional"],
          "properties": {
            "statement": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
            "inference": { "const": true },
            "provisional": { "type": "boolean" }
          }
        }
      ]
    },
    "supporting_evidence_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/evidenceId" }, "uniqueItems": true },
    "conflicting_evidence_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/evidenceId" }, "uniqueItems": true },
    "affected": {
      "type": "object", "additionalProperties": false, "required": ["tasks", "routes", "components", "content"],
      "properties": {
        "tasks": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/taskId" }, "uniqueItems": true },
        "routes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "components": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "content": { "type": "array", "items": { "type": "string", "pattern": "^CONTENT-" }, "uniqueItems": true }
      }
    },
    "specialist_coverage": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "root_cause_confidence": { "$ref": "urn:aud:schema:common:v1#/$defs/confidence" },
    "unresolved_assumptions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
