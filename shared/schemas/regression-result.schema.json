{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aud:schema:regression-result:v1",
  "title": "AUD regression result set v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "regression_set_id", "verification_plan_id", "run_id", "baseline_revision", "candidate_revision", "generated_at", "results", "new_finding_refs"],
  "properties": {
    "schema_version": { "const": "aud-regression-result-v1" },
    "regression_set_id": { "type": "string", "pattern": "^REGSET-" },
    "verification_plan_id": { "type": "string", "pattern": "^VP-" },
    "run_id": { "$ref": "urn:aud:schema:common:v1#/$defs/runId" },
    "baseline_revision": { "$ref": "urn:aud:schema:common:v1#/$defs/sha" }, "candidate_revision": { "$ref": "urn:aud:schema:common:v1#/$defs/sha" },
    "generated_at": { "$ref": "urn:aud:schema:common:v1#/$defs/timestamp" },
    "results": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["regression_id", "case_id", "classification", "scope", "comparison", "outcome", "baseline_observation", "current_observation", "evidence_refs", "rationale", "executor", "new_finding_id"],
      "properties": {
        "regression_id": { "type": "string", "pattern": "^REG-" }, "case_id": { "type": "string", "pattern": "^VC-" },
        "classification": { "enum": ["original_problem_verification", "targeted_regression", "unrelated_pre_existing", "newly_introduced_regression"] },
        "scope": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "comparison": { "enum": ["fixed", "improved_but_incomplete", "unchanged", "worsened", "no_longer_reproducible", "unable_to_compare"] },
        "outcome": { "enum": ["passed", "partially_passed", "failed", "blocked", "inconclusive", "not_run"] },
        "baseline_observation": { "type": ["string", "null"] }, "current_observation": { "type": ["string", "null"] },
        "evidence_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/evidenceId" }, "uniqueItems": true },
        "rationale": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
        "executor": { "type": "object", "additionalProperties": false, "required": ["category", "adapter", "manual", "provenance"], "properties": { "category": { "enum": ["automated_test", "browser_interaction", "visual_comparison", "content_inspection", "accessibility_check", "performance_measurement", "manual_expert_review", "evidence_only_investigation", "readiness_gate"] }, "adapter": { "type": ["string", "null"] }, "manual": { "type": "boolean" }, "provenance": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" } } },
        "new_finding_id": { "oneOf": [{ "$ref": "urn:aud:schema:common:v1#/$defs/findingId" }, { "type": "null" }] }
      }
    } },
    "new_finding_refs": { "type": "array", "items": { "$ref": "urn:aud:schema:common:v1#/$defs/findingId" }, "uniqueItems": true }
  }
}
