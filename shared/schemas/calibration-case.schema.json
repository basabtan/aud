{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aud:schema:calibration-case:v1",
  "title": "AUD calibration case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "case_version", "title", "category", "tiers", "mandatory", "input_revision", "fixture", "expected", "observed_runs"],
  "properties": {
    "schema_version": { "const": "aud-calibration-case-v1" },
    "case_id": { "type": "string", "pattern": "^CALCASE-" },
    "case_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
    "category": { "enum": ["finding", "deduplication", "relationship", "contradiction", "root_cause", "remediation", "verification", "regression", "evidence", "execution", "authority"] },
    "tiers": { "type": "array", "minItems": 1, "items": { "enum": ["fast", "full"] }, "uniqueItems": true },
    "mandatory": { "type": "boolean" },
    "input_revision": { "$ref": "urn:aud:schema:common:v1#/$defs/sha" },
    "fixture": {
      "type": "object",
      "additionalProperties": true,
      "required": ["description", "synthetic"],
      "properties": {
        "description": { "$ref": "urn:aud:schema:common:v1#/$defs/nonEmptyString" },
        "synthetic": { "const": true }
      }
    },
    "expected": { "$ref": "urn:aud:schema:expected-outcome:v1" },
    "observed_runs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_label", "generated_at"],
        "properties": {
          "run_label": { "type": "string" },
          "generated_at": { "$ref": "urn:aud:schema:common:v1#/$defs/timestamp" },
          "output": { "type": "object", "additionalProperties": true },
          "same_as": { "type": "string" }
        },
        "oneOf": [
          { "required": ["output"], "properties": { "output": true } },
          { "required": ["same_as"], "properties": { "same_as": true } }
        ]
      }
    }
  }
}
